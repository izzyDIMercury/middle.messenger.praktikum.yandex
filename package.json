{
  "name": "messenger",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000 --open",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint ./src --ext .ts & stylelint src/**/*.scss",
    "start": "npm run build && node server.cjs",
    "test": "mocha  --es-module-specifier-resolution=node",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/chai": "^4.3.17",
    "@types/mocha": "^10.0.7",
    "@types/node": "^22.2.0",
    "@types/sinon": "^17.0.3",
    "@types/sinon-chai": "^3.2.12",
    "@typescript-eslint/eslint-plugin": "^7.12.0",
    "@typescript-eslint/parser": "^7.12.0",
    "chai": "^5.1.1",
    "eslint": "^8.57.0",
    "globals": "^15.3.0",
    "i": "^0.3.7",
    "jsdom": "^24.1.1",
    "mocha": "^10.7.3",
    "npm": "^10.8.2",
    "sass": "^1.71.1",
    "sinon": "^18.0.0",
    "sinon-chai": "^4.0.0",
    "stylelint": "^16.6.1",
    "stylelint-config-standard-scss": "^13.1.0",
    "stylelint-order": "^6.0.4",
    "stylelint-scss": "^6.3.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.2.2",
    "typescript-eslint": "^7.12.0",
    "vite": "^5.1.4"
  },
  "dependencies": {
    "express": "^4.18.3",
    "handlebars": "^4.7.8",
    "husky": "^8.0.3",
    "uuid": "^9.0.1"
  },
  "husky": {
    "pre-commit": "npm lint && npm test"
  }
}
